<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements для hardened runtime.

  `disable-library-validation` — НЕ послаблення заради зручності, а вимога
  архітектури: ми запускаємо власний Python-рантайм, який завантажує десятки
  .so/.dylib з коліс PyPI (onnxruntime, numpy, apsw, usearch). Вони підписані
  іншими Team ID або не підписані взагалі; з увімкненою валідацією бібліотек
  dyld відмовить їх завантажувати, і застосунок помре на першому `import numpy`.

  `allow-jit` потрібен WKWebView (JavaScriptCore), `allow-unsigned-executable-memory`
  — тому самому JIT-у в дочірньому процесі веб-контенту.

  Мережевих entitlements немає навмисно: закритий контур. `network.client`
  не потрібен для петлі назад у не-sandboxed застосунку.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <false/>
</dict>
</plist>
